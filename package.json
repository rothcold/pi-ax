{
  "name": "@rothcold/pi-ax",
  "version": "0.1.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Pi extension for one-shot workers in Google AX sandboxes with verified result export and explicit cleanup.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rothcold/pi-ax.git"
  },
  "homepage": "https://github.com/rothcold/pi-ax#readme",
  "bugs": {
    "url": "https://github.com/rothcold/pi-ax/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "generate:proto": "node scripts/generate-proto.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "build:image": "node scripts/build-image.mjs",
    "check:package": "node scripts/check-package.mjs",
    "local:ax": "bash scripts/local-ax.sh",
    "e2e:wire": "node --import tsx scripts/e2e.ts wire",
    "e2e:sqlite": "node --import tsx scripts/e2e.ts sqlite",
    "lint": "node scripts/check.mjs lint",
    "typecheck": "node scripts/check.mjs typecheck",
    "test": "node scripts/check.mjs test",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "@grpc/proto-loader": "0.8.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "typebox": "1.3.34"
  },
  "files": ["ax-config.example.json", "src/", "proto/", "worker/", "scripts/", "tests/", "docs/", "AGENTS.md", "npm-shrinkwrap.json", "tsconfig.json", "eslint.config.mjs", ".dockerignore", "!worker/node_modules/"],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
